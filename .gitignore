# ========================
# APEX CORTEX - .gitignore
# ========================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
.Python
develop-eggs/
lib/
lib64/
sdist/
var/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
ENV/
env/

# Python tooling
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----- Vite / Frontend build -----
dashboard/dist/
dashboard/.vite/
*.local

# ----- Environment -----
.env
.env.local
.env.*.local

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Project-specific -----
sessions/*.json
sessions/*.csv
sessions/*.log
!sessions/.gitkeep

# OBD logs
*.obd.log
*.can.log

# GPS traces
*.gpx
*.nmea
