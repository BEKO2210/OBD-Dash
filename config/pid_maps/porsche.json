{
  "$schema": "apex-cortex-pid-map-v1",
  "id": "porsche",
  "name": "Porsche Extended PIDs",
  "description": "Mode 22 manufacturer-specific PIDs for Porsche vehicles (992 platform, 9A1 engine family)",
  "mode": "22",
  "ecu_header": "0x7E0",
  "pids": {
    "0x0100": {
      "name": "transmission_temp",
      "description": "PDK transmission oil temperature",
      "formula": "((A * 256) + B) / 10 - 40",
      "unit": "°C",
      "min": -40,
      "max": 200,
      "bytes": 2,
      "sample_rate_hz": 2,
      "priority": "high"
    },
    "0x0102": {
      "name": "transmission_gear",
      "description": "Currently engaged PDK gear",
      "formula": "A",
      "unit": "gear",
      "min": 0,
      "max": 9,
      "bytes": 1,
      "sample_rate_hz": 10,
      "priority": "critical"
    },
    "0x0103": {
      "name": "clutch_1_status",
      "description": "PDK clutch 1 engagement (odd gears)",
      "formula": "A / 2.55",
      "unit": "%",
      "min": 0,
      "max": 100,
      "bytes": 1,
      "sample_rate_hz": 10,
      "priority": "medium"
    },
    "0x0104": {
      "name": "clutch_2_status",
