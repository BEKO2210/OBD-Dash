{
  "$schema": "apex-cortex-pid-map-v1",
  "id": "bmw_m",
  "name": "BMW M Extended PIDs",
  "description": "Mode 22 manufacturer-specific PIDs for BMW M vehicles (S58 engine, G80/G82 platform)",
  "mode": "22",
  "ecu_header": "0x7E0",
  "pids": {
    "0x0500": {
      "name": "transmission_temp",
      "description": "Automatic transmission fluid temperature",
      "formula": "((A * 256) + B) / 10 - 40",
      "unit": "°C",
      "min": -40,
      "max": 200,
      "bytes": 2,
      "sample_rate_hz": 2,
      "priority": "high"
    },
    "0x0502": {
      "name": "transmission_gear",
      "description": "Currently engaged gear",
      "formula": "A",
      "unit": "gear",
      "min": 0,
      "max": 10,
      "bytes": 1,
      "sample_rate_hz": 10,
      "priority": "critical"
    },
    "0x0503": {
      "name": "gear_request",
      "description": "Requested target gear",
      "formula": "A",
      "unit": "gear",
      "min": 0,
      "max": 10,
      "bytes": 1,
      "sample_rate_hz": 10,
      "priority": "medium"
    },
    "0x1050": {
      "name": "turbo_boost_actual",
      "description": "Actual charge pressure (absolute)",
      "formula": "((A * 256) + B) / 100",
      "unit": "bar",
      "min": 0,
      "max": 3.5,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "critical"
    },
    "0x1051": {
      "name": "turbo_boost_target",
      "description": "Target charge pressure",
      "formula": "((A * 256) + B) / 100",
      "unit": "bar",
      "min": 0,
      "max": 3.5,
      "bytes": 2,
      "sample_rate_hz": 10,
      "priority": "high"
    },
    "0x1060": {
      "name": "wastegate_duty",
      "description": "Wastegate duty cycle",
      "formula": "A / 2.55",
      "unit": "%",
      "min": 0,
      "max": 100,
      "bytes": 1,
      "sample_rate_hz": 10,
      "priority": "medium"
    },
    "0x1070": {
      "name": "intercooler_temp",
      "description": "Charge air cooler temperature",
      "formula": "((A * 256) + B) / 10 - 40",
      "unit": "°C",
      "min": -40,
      "max": 150,
      "bytes": 2,
      "sample_rate_hz": 2,
      "priority": "medium"
    },
    "0x2040": {
      "name": "brake_pressure",
      "description": "Master cylinder brake pressure",
      "formula": "((A * 256) + B) / 10",
      "unit": "bar",
      "min": 0,
      "max": 200,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "critical"
    },
    "0x2050": {
      "name": "brake_disc_temp_fl",
      "description": "Brake disc temperature - front left (estimated)",
      "formula": "((A * 256) + B) / 10",
      "unit": "°C",
      "min": 0,
      "max": 900,
      "bytes": 2,
      "sample_rate_hz": 2,
      "priority": "high"
    },
    "0x2051": {
      "name": "brake_disc_temp_fr",
      "description": "Brake disc temperature - front right (estimated)",
      "formula": "((A * 256) + B) / 10",
      "unit": "°C",
      "min": 0,
      "max": 900,
      "bytes": 2,
      "sample_rate_hz": 2,
      "priority": "high"
    },
    "0x2100": {
      "name": "steering_angle",
      "description": "Steering wheel angle",
      "formula": "((A * 256) + B) / 10 - 3276.8",
      "unit": "°",
      "min": -900,
      "max": 900,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "high"
    },
    "0x2200": {
      "name": "lateral_acceleration",
