      "sample_rate_hz": 1,
      "priority": "medium"
    },
    "0x5020": {
      "name": "dsc_status",
      "description": "DSC / M Dynamic Mode status",
      "formula": "A",
      "unit": "status",
      "min": 0,
      "max": 3,
      "bytes": 1,
      "sample_rate_hz": 10,
      "priority": "high",
      "enum_values": {
        "0": "DSC On",
        "1": "MDM (M Dynamic Mode)",
        "2": "DSC Off",
        "3": "Intervening"
      }
    }
  }
