      "min": -3.0,
      "max": 3.0,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "critical"
    },
    "0x2201": {
      "name": "longitudinal_acceleration",
      "description": "Longitudinal acceleration",
      "formula": "((A * 256) + B) / 1000 - 32.768",
      "unit": "g",
      "min": -3.0,
      "max": 3.0,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "critical"
    },
    "0x2300": {
      "name": "yaw_rate",
      "description": "Yaw rate sensor",
      "formula": "((A * 256) + B) / 100 - 327.68",
