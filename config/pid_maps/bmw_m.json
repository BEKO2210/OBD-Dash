      "min": 0,
      "max": 350,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "high"
    },
    "0x3001": {
      "name": "wheel_speed_fr",
      "description": "Wheel speed - front right",
      "formula": "((A * 256) + B) / 100",
      "unit": "km/h",
      "min": 0,
      "max": 350,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "high"
    },
    "0x3002": {
      "name": "wheel_speed_rl",
      "description": "Wheel speed - rear left",
      "formula": "((A * 256) + B) / 100",
      "unit": "km/h",
      "min": 0,
      "max": 350,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "high"
    },
    "0x3003": {
      "name": "wheel_speed_rr",
      "description": "Wheel speed - rear right",
      "formula": "((A * 256) + B) / 100",
      "unit": "km/h",
      "min": 0,
      "max": 350,
      "bytes": 2,
      "sample_rate_hz": 20,
      "priority": "high"
    },
    "0x4000": {
      "name": "exhaust_gas_temp_pre_cat",
      "description": "Exhaust gas temperature pre-catalytic converter",
      "formula": "((A * 256) + B) / 10 - 40",
      "unit": "°C",
      "min": -40,
      "max": 1100,
      "bytes": 2,
      "sample_rate_hz": 2,
      "priority": "high"
    },
    "0x5000": {
      "name": "m_drive_mode",
      "description": "M Drive mode selection",
      "formula": "A",
      "unit": "mode",
      "min": 0,
      "max": 4,
      "bytes": 1,
      "sample_rate_hz": 1,
      "priority": "medium",
      "enum_values": {
        "0": "Comfort",
        "1": "Sport",
        "2": "Sport+",
        "3": "Track",
        "4": "Efficient"
      }
    },
    "0x5010": {
      "name": "m_traction_level",
