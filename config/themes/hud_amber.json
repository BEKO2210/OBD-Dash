{
  "$schema": "apex-cortex-theme-v1",
  "id": "hud_amber",
  "name": "HUD Amber",
  "description": "Amber heads-up display style inspired by fighter jet avionics",
  "mode": "dark",
  "colors": {
    "background": {
      "primary": "#000000",
      "secondary": "#0a0800",
      "tertiary": "#141000",
      "surface": "#0f0c00",
      "elevated": "#1a1500"
    },
    "foreground": {
      "primary": "#ffbe20",
      "secondary": "#cc9810",
      "muted": "#7a5c0a",
      "inverse": "#000000"
    },
    "accent": {
      "primary": "#ffbe20",
      "secondary": "#ff6600",
      "tertiary": "#ffd24a",
      "success": "#66cc00",
      "warning": "#ff9900",
      "danger": "#ff3300",
      "info": "#ffbe20"
    },
    "gauge": {
      "rpm_low": "#66cc00",
      "rpm_mid": "#ffbe20",
      "rpm_high": "#ff6600",
      "rpm_redline": "#ff3300",
      "speed": "#ffbe20",
      "throttle": "#66cc00",
      "brake": "#ff3300",
      "boost": "#ffd24a",
      "temp_cold": "#3399ff",
      "temp_normal": "#66cc00",
      "temp_warm": "#ff9900",
      "temp_hot": "#ff3300",
      "fuel_full": "#66cc00",
      "fuel_low": "#ff9900",
      "fuel_critical": "#ff3300"
    },
    "border": {
      "default": "#4d3a00",
      "subtle": "#332800",
      "strong": "#997300"
    },
    "overlay": {
      "backdrop": "rgba(0, 0, 0, 0.90)",
      "tooltip": "rgba(15, 12, 0, 0.95)"
    }
  },
  "typography": {
    "font_family_display": "Orbitron, sans-serif",
    "font_family_body": "JetBrains Mono, Fira Code, monospace",
    "font_family_mono": "JetBrains Mono, Fira Code, monospace",
    "font_size": {
      "xs": "0.625rem",
      "sm": "0.75rem",
      "base": "0.875rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "2.5rem",
      "5xl": "3.5rem",
      "gauge_value": "3rem",
      "speedometer": "5rem",
      "rpm_value": "4rem"
    },
    "font_weight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 900
    }
  },
  "spacing": {
    "gauge_gap": "0.5rem",
    "panel_padding": "1rem",
    "section_gap": "1.5rem"
  },
  "borders": {
    "radius_sm": "0px",
    "radius_md": "0px",
    "radius_lg": "2px",
    "radius_xl": "2px",
    "radius_gauge": "9999px",
    "width": "1px"
  },
  "effects": {
    "glow_primary": "0 0 15px rgba(255, 190, 32, 0.5)",
    "glow_accent": "0 0 15px rgba(255, 102, 0, 0.5)",
    "glow_speed": "0 0 15px rgba(255, 190, 32, 0.5)",
    "shadow_panel": "0 0 1px rgba(255, 190, 32, 0.3), inset 0 0 1px rgba(255, 190, 32, 0.1)",
    "shadow_elevated": "0 0 2px rgba(255, 190, 32, 0.4), inset 0 0 2px rgba(255, 190, 32, 0.15)",
    "text_shadow": "0 0 8px rgba(255, 190, 32, 0.6)",
    "scanline_opacity": 0.03,
    "backdrop_blur": "0px",
    "transition_fast": "100ms linear",
    "transition_normal": "200ms linear",
    "transition_slow": "350ms linear"
  },
  "gauge_styles": {
    "arc_width": 4,
    "arc_background": "#1a1500",
    "needle_color": "#ffbe20",
    "tick_color": "#7a5c0a",
    "label_color": "#cc9810",
    "value_color": "#ffbe20",
    "render_mode": "wireframe"
  },
  "hud_specific": {
    "scanlines_enabled": true,
    "scanline_spacing_px": 3,
    "scanline_color": "rgba(255, 190, 32, 0.03)",
    "crosshair_enabled": true,
    "grid_overlay": true,
    "grid_color": "rgba(255, 190, 32, 0.05)",
    "grid_spacing_px": 40,
    "vignette_enabled": true,
    "vignette_intensity": 0.6,
    "flicker_enabled": false,
    "monochrome": true
  }
}
