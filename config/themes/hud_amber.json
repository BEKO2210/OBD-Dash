{
  "$schema": "apex-cortex-theme-v1",
  "id": "hud_amber",
  "name": "HUD Amber",
  "description": "Amber-tinted heads-up display theme inspired by military and aviation HUDs",
  "mode": "dark",
  "colors": {
    "background": {
      "primary": "#080600",
      "secondary": "#121005",
      "tertiary": "#1e1a0a",
      "surface": "#141108",
      "elevated": "#1c180c"
    },
    "foreground": {
      "primary": "#ffbf40",
      "secondary": "#cc9933",
      "muted": "#806020",
      "inverse": "#080600"
    },
    "accent": {
      "primary": "#ffbf40",
      "secondary": "#ff9500",
      "tertiary": "#e6a817",
      "success": "#8db600",
      "warning": "#ff9500",
      "danger": "#ff3b30",
      "info": "#e6a817"
    },
    "gauge": {
      "rpm_low": "#8db600",
      "rpm_mid": "#ffbf40",
      "rpm_high": "#ff9500",
      "rpm_redline": "#ff3b30",
      "speed": "#ffbf40",
      "throttle": "#e6a817",
      "brake": "#ff3b30",
      "boost": "#ff9500",
      "temp_cold": "#5a8a00",
      "temp_normal": "#8db600",
      "temp_warm": "#ff9500",
      "temp_hot": "#ff3b30",
      "fuel_full": "#8db600",
      "fuel_low": "#ff9500",
      "fuel_critical": "#ff3b30"
    },
    "border": {
      "default": "#3d3510",
      "subtle": "#2a2409",
      "strong": "#806020"
    },
    "overlay": {
      "backdrop": "rgba(8, 6, 0, 0.90)",
      "tooltip": "rgba(20, 17, 8, 0.95)"
    }
  },
  "typography": {
    "font_family_display": "Orbitron, sans-serif",
    "font_family_body": "Inter, system-ui, sans-serif",
    "font_family_mono": "JetBrains Mono, Fira Code, monospace",
    "font_size": {
      "xs": "0.625rem",
      "sm": "0.75rem",
      "base": "0.875rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "2.5rem",
      "5xl": "3.5rem",
      "gauge_value": "3rem",
      "speedometer": "5rem",
      "rpm_value": "4rem"
    },
    "font_weight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 900
    }
  },
  "spacing": {
    "gauge_gap": "0.5rem",
    "panel_padding": "1rem",
    "section_gap": "1.5rem"
  },
  "borders": {
    "radius_sm": "0.25rem",
    "radius_md": "0.5rem",
    "radius_lg": "0.75rem",
    "radius_xl": "1rem",
    "radius_gauge": "9999px",
    "width": "1px"
  },
  "effects": {
    "glow_primary": "0 0 12px rgba(255, 191, 64, 0.4)",
    "glow_accent": "0 0 12px rgba(255, 149, 0, 0.4)",
    "glow_speed": "0 0 12px rgba(255, 191, 64, 0.3)",
    "shadow_panel": "0 4px 24px rgba(0, 0, 0, 0.6)",
    "shadow_elevated": "0 8px 32px rgba(0, 0, 0, 0.8)",
    "backdrop_blur": "12px",
    "transition_fast": "150ms ease",
    "transition_normal": "250ms ease",
    "transition_slow": "400ms ease"
  },
  "gauge_styles": {
    "arc_width": 8,
    "arc_background": "#1e1a0a",
    "needle_color": "#ffbf40",
    "tick_color": "#806020",
    "label_color": "#cc9933",
    "value_color": "#ffbf40"
  }
}
